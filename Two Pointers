    public int removeDuplicates(int[] nums) {

    if(nums.length == 0){
       return 0;
    }

    int pointer = 1;

    for(int i = 1; i < nums.length; i++){

       if(nums[i] != nums[i-1]){
            nums[pointer] = nums[i];
            pointer++;
        }

    }
      
    return pointer;
        
